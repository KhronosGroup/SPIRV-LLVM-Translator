; REQUIRES: spirv-as

; RUN: spirv-as %s --target-env spv1.6 -o %t.spv
; RUN: spirv-val %t.spv
; RUN: llvm-spirv -r --spirv-target-env=SPV-IR %t.spv -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc -o - | FileCheck %s
; RUN: llvm-spirv %t.rev.bc -o %t.fwd.spv
; RUN: spirv-val %t.fwd.spv

; Check that a UniformId decoration on an OpVariable survives a -r round
; trip: it must show up as !spirv.Decorations metadata with the resolved
; scope value (not the SPIR-V id of the scope constant), and translating
; that metadata back to SPIR-V must produce a valid module again.

; CHECK: global i32 0, !spirv.Decorations ![[DECOS:[0-9]+]]
; CHECK: ![[DECOS]] = !{![[DECO:[0-9]+]]}
; CHECK: ![[DECO]] = !{i32 27, i32 2}

               OpCapability Addresses
               OpCapability Kernel
               OpCapability UniformDecoration
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %2 "test"
               OpDecorateId %var UniformId %scope
       %uint = OpTypeInt 32 0
      %scope = OpConstant %uint 2
   %uint_ptr = OpTypePointer CrossWorkgroup %uint
        %var = OpVariable %uint_ptr CrossWorkgroup
       %void = OpTypeVoid
          %1 = OpTypeFunction %void
          %2 = OpFunction %void None %1
          %3 = OpLabel
               OpReturn
               OpFunctionEnd
