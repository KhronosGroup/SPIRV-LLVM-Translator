; Check that UniformId, AlignmentId and MaxByteOffsetId decorations on an
; OpVariable survive a -r round trip: they must show up as !spirv.Decorations
; metadata with the resolved constant value (not the SPIR-V id of the
; constant), and translating that metadata back to SPIR-V must produce a valid
; module again with the id operand restored to the correct value.

; RUN: llvm-spirv %s -to-binary -o %t.spv
; RUN: spirv-val %t.spv
; RUN: llvm-spirv -r --spirv-target-env=SPV-IR %t.spv -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc -o - | FileCheck %s --check-prefix=CHECK-LLVM
; RUN: llvm-spirv %t.rev.bc -o %t.fwd.spv
; RUN: spirv-val %t.fwd.spv
; RUN: llvm-spirv %t.fwd.spv -to-text -o %t.fwd.spt
; RUN: FileCheck < %t.fwd.spt %s --check-prefix=CHECK-SPIRV

; CHECK-LLVM: @var = {{.*}}global i32 0, !spirv.Decorations ![[DECOS:[0-9]+]]
; CHECK-LLVM: @var_align = {{.*}}global i32 0, {{.*}}!spirv.Decorations ![[ALIGN_DECOS:[0-9]+]]
; CHECK-LLVM: @var_offset = {{.*}}global i32 0, !spirv.Decorations ![[OFFSET_DECOS:[0-9]+]]
; CHECK-LLVM: ![[DECOS]] = !{![[DECO:[0-9]+]]}
; CHECK-LLVM: ![[DECO]] = !{i32 27, i32 2}
; CHECK-LLVM: ![[ALIGN_DECOS]] = !{![[ALIGN_DECO:[0-9]+]]}
; CHECK-LLVM: ![[ALIGN_DECO]] = !{i32 46, i32 8}
; CHECK-LLVM: ![[OFFSET_DECOS]] = !{![[OFFSET_DECO:[0-9]+]]}
; CHECK-LLVM: ![[OFFSET_DECO]] = !{i32 47, i32 16}

; CHECK-SPIRV-DAG: DecorateId {{[0-9]+}} UniformId [[SCOPE:[0-9]+]]
; CHECK-SPIRV-DAG: DecorateId {{[0-9]+}} AlignmentId [[ALIGN:[0-9]+]]
; CHECK-SPIRV-DAG: DecorateId {{[0-9]+}} MaxByteOffsetId [[OFFSET:[0-9]+]]
; CHECK-SPIRV-DAG: Constant {{[0-9]+}} [[SCOPE]] 2
; CHECK-SPIRV-DAG: Constant {{[0-9]+}} [[ALIGN]] 8
; CHECK-SPIRV-DAG: Constant {{[0-9]+}} [[OFFSET]] 16

119734787 67072 458752 14 0

2 Capability Addresses
2 Capability Kernel
2 Capability UniformDecoration
3 MemoryModel 2 2
5 EntryPoint 6 1 "test"
3 Name 2 "var"
5 Name 9 "var_align"
5 Name 10 "var_offset"

4 DecorateId 2 UniformId 3    ; %var UniformId %scope
4 DecorateId 9 AlignmentId 11 ; %var_align AlignmentId %align
4 DecorateId 10 MaxByteOffsetId 12 ; %var_offset MaxByteOffsetId %offset

4 TypeInt 4 32 0              ; %uint = OpTypeInt 32 0
4 Constant 4 3 2              ; %scope = OpConstant %uint 2
4 Constant 4 11 8             ; %align = OpConstant %uint 8
4 Constant 4 12 16            ; %offset = OpConstant %uint 16
4 TypePointer 5 5 4           ; %uint_ptr = OpTypePointer CrossWorkgroup %uint
2 TypeVoid 6                  ; %void = OpTypeVoid
3 TypeFunction 7 6            ; %1 = OpTypeFunction %void
4 Variable 5 2 5              ; %var = OpVariable %uint_ptr CrossWorkgroup
4 Variable 5 9 5              ; %var_align = OpVariable %uint_ptr CrossWorkgroup
4 Variable 5 10 5             ; %var_offset = OpVariable %uint_ptr CrossWorkgroup

5 Function 6 1 0 7            ; %2 = OpFunction %void None %1
2 Label 8                     ; %3 = OpLabel
1 Return
1 FunctionEnd
