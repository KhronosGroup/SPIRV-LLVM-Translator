; Checks the reader rejects OpBitwiseAnd when its OpTypeVectorIdEXT operands have
; different component counts.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: BitwiseAnd: result and inputs must all have equal component count for vector types.

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %f "f"
               OpDecorate %f LinkageAttributes "f" Export
       %uint = OpTypeInt 32 0
         %u5 = OpConstant %uint 5
         %u8 = OpConstant %uint 8
        %v5u = OpTypeVectorIdEXT %uint %u5
        %v8u = OpTypeVectorIdEXT %uint %u8
       %fnty = OpTypeFunction %v5u %v5u %v8u
          %f = OpFunction %v5u None %fnty
          %a = OpFunctionParameter %v5u
          %b = OpFunctionParameter %v8u
          %e = OpLabel
          %r = OpBitwiseAnd %v5u %a %b
               OpReturnValue %r
               OpFunctionEnd
