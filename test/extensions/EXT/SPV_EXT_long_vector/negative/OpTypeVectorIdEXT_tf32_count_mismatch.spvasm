; Checks the reader rejects OpRoundFToTF32INTEL whose OpTypeVectorIdEXT result and
; input counts differ only after a spec-constant override. spirv-val accepts the
; module at defaults (both counts 5); the mismatch is one only the reader sees.
; The OK run also proves id-typed TF32 is now accepted at all (previously
; rejected at the element-type check).

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.4 -o %t.spv %s
; RUN: spirv-val %t.spv
; RUN: llvm-spirv -r %t.spv -o - | llvm-dis | FileCheck %s --check-prefix=CHECK
; RUN: not llvm-spirv -r -spec-const "43:i32:8" %t.spv -o %t.bc 2>&1 | FileCheck %s --check-prefix=CHECK-ERROR

; CHECK: call spir_func <5 x float> @{{.*}}RoundFToTF32INTEL{{.*}}(<5 x float>
; CHECK-ERROR: RoundFToTF32INTEL: result and input must have equal component count for vector types.

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpCapability TensorFloat32RoundingINTEL
               OpExtension "SPV_EXT_long_vector"
               OpExtension "SPV_INTEL_tensor_float32_conversion"
               OpMemoryModel Physical64 OpenCL
               OpName %f "f"
               OpDecorate %f LinkageAttributes "f" Export
               OpDecorate %sc_a SpecId 42
               OpDecorate %sc_b SpecId 43
      %float = OpTypeFloat 32
       %uint = OpTypeInt 32 0
       %sc_a = OpSpecConstant %uint 5
       %sc_b = OpSpecConstant %uint 5
        %v5a = OpTypeVectorIdEXT %float %sc_a
        %v5b = OpTypeVectorIdEXT %float %sc_b
       %fnty = OpTypeFunction %v5a %v5b
          %f = OpFunction %v5a None %fnty
          %a = OpFunctionParameter %v5b
          %e = OpLabel
          %r = OpRoundFToTF32INTEL %v5a %a
               OpReturnValue %r
               OpFunctionEnd
