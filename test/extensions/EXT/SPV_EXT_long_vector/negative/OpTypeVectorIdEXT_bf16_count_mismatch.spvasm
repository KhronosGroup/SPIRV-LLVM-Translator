; Checks the reader rejects OpConvertFToBF16INTEL when the OpTypeVectorIdEXT result
; and input have different component counts (otherwise a wrong builtin is emitted
; silently in all build types).

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: ConvertFToBF16INTEL: result and input must have equal component count for vector types.

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpCapability Int16
               OpCapability BFloat16ConversionINTEL
               OpExtension "SPV_EXT_long_vector"
               OpExtension "SPV_INTEL_bfloat16_conversion"
               OpMemoryModel Physical64 OpenCL
               OpName %f "f"
               OpDecorate %f LinkageAttributes "f" Export
      %float = OpTypeFloat 32
      %short = OpTypeInt 16 0
       %uint = OpTypeInt 32 0
         %u5 = OpConstant %uint 5
         %u8 = OpConstant %uint 8
        %v5s = OpTypeVectorIdEXT %short %u5
        %v8f = OpTypeVectorIdEXT %float %u8
       %fnty = OpTypeFunction %v5s %v8f
          %f = OpFunction %v5s None %fnty
          %a = OpFunctionParameter %v8f
          %e = OpLabel
          %r = OpConvertFToBF16INTEL %v5s %a
               OpReturnValue %r
               OpFunctionEnd
