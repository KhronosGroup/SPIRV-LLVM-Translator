; Checks the reader rejects OpFAdd when its OpTypeVectorIdEXT operands have
; different component counts.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: FAdd: result and inputs must all have equal component count for vector types.

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %f "f"
               OpDecorate %f LinkageAttributes "f" Export
      %float = OpTypeFloat 32
       %uint = OpTypeInt 32 0
         %u5 = OpConstant %uint 5
         %u8 = OpConstant %uint 8
        %v5f = OpTypeVectorIdEXT %float %u5
        %v8f = OpTypeVectorIdEXT %float %u8
       %fnty = OpTypeFunction %v5f %v5f %v8f
          %f = OpFunction %v5f None %fnty
          %a = OpFunctionParameter %v5f
          %b = OpFunctionParameter %v8f
          %e = OpLabel
          %r = OpFAdd %v5f %a %b
               OpReturnValue %r
               OpFunctionEnd
