; Checks the reader rejects OpLogicalAnd when its OpTypeVectorIdEXT operands have
; different component counts.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: not llvm-spirv -r %t.spv -o %t.bc 2>&1 | FileCheck %s

; CHECK: LogicalAnd: result and inputs must all have equal component count for vector types.

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %f "f"
               OpDecorate %f LinkageAttributes "f" Export
       %uint = OpTypeInt 32 0
       %bool = OpTypeBool
         %u5 = OpConstant %uint 5
         %u8 = OpConstant %uint 8
        %v5b = OpTypeVectorIdEXT %bool %u5
        %v8b = OpTypeVectorIdEXT %bool %u8
       %fnty = OpTypeFunction %v5b %v5b %v8b
          %f = OpFunction %v5b None %fnty
          %a = OpFunctionParameter %v5b
          %b = OpFunctionParameter %v8b
          %e = OpLabel
          %r = OpLogicalAnd %v5b %a %b
               OpReturnValue %r
               OpFunctionEnd
