; Checks reverse-translation of value-level ops on an OpTypeVectorIdEXT value:
; OpVectorExtractDynamic, OpVectorInsertDynamic, OpVectorShuffle, OpAccessChain.

; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.3 -o %t.spv %s
; RUN: spirv-val %t.spv
; RUN: llvm-spirv -r -o - %t.spv | llvm-dis | FileCheck %s

; CHECK: define spir_func float @test_vec_extract_dynamic(<5 x float> %[[#V:]], i32 %[[#I:]])
; CHECK: extractelement <5 x float> %[[#V]], i32 %[[#I]]

; CHECK: define spir_func <5 x float> @test_vec_insert_dynamic(<5 x float> %[[#V:]], float %[[#S:]], i32 %[[#I:]])
; CHECK: insertelement <5 x float> %[[#V]], float %[[#S]], i32 %[[#I]]

; CHECK: define spir_func <5 x float> @test_vec_shuffle(<5 x float> %[[#A:]], <5 x float> %[[#B:]])
; CHECK: shufflevector <5 x float> %[[#A]], <5 x float> %[[#B]]

; CHECK: define spir_func float @test_access_chain(i32 %[[#I:]])
; CHECK: getelementptr <5 x float>, ptr %{{[0-9]+}}, i32 0, i32 %[[#I]]
; CHECK: load float

               OpCapability Kernel
               OpCapability Addresses
               OpCapability Linkage
               OpCapability LongVectorEXT
               OpExtension "SPV_EXT_long_vector"
               OpMemoryModel Physical64 OpenCL
               OpName %fn_ved "test_vec_extract_dynamic"
               OpName %fn_vid "test_vec_insert_dynamic"
               OpName %fn_vs "test_vec_shuffle"
               OpName %fn_ac "test_access_chain"
               OpDecorate %fn_ved LinkageAttributes "test_vec_extract_dynamic" Export
               OpDecorate %fn_vid LinkageAttributes "test_vec_insert_dynamic" Export
               OpDecorate %fn_vs LinkageAttributes "test_vec_shuffle" Export
               OpDecorate %fn_ac LinkageAttributes "test_access_chain" Export
       %uint = OpTypeInt 32 0
      %float = OpTypeFloat 32
     %uint_5 = OpConstant %uint 5
   %count_sc = OpSpecConstant %uint 5
    %v5float = OpTypeVectorIdEXT %float %uint_5
 %v5float_sc = OpTypeVectorIdEXT %float %count_sc
 %ptr_fn_v5f = OpTypePointer Function %v5float
 %ptr_fn_flt = OpTypePointer Function %float
   %fnty_ved = OpTypeFunction %float %v5float_sc %uint
   %fnty_vid = OpTypeFunction %v5float %v5float %float %uint
    %fnty_vs = OpTypeFunction %v5float %v5float %v5float
    %fnty_ac = OpTypeFunction %float %uint

     %fn_ved = OpFunction %float None %fnty_ved
      %ved_v = OpFunctionParameter %v5float_sc
      %ved_i = OpFunctionParameter %uint
  %entry_ved = OpLabel
       %vedr = OpVectorExtractDynamic %float %ved_v %ved_i
               OpReturnValue %vedr
               OpFunctionEnd

     %fn_vid = OpFunction %v5float None %fnty_vid
      %vid_v = OpFunctionParameter %v5float
      %vid_s = OpFunctionParameter %float
      %vid_i = OpFunctionParameter %uint
  %entry_vid = OpLabel
       %vidr = OpVectorInsertDynamic %v5float %vid_v %vid_s %vid_i
               OpReturnValue %vidr
               OpFunctionEnd

      %fn_vs = OpFunction %v5float None %fnty_vs
       %vs_a = OpFunctionParameter %v5float
       %vs_b = OpFunctionParameter %v5float
   %entry_vs = OpLabel
        %vsr = OpVectorShuffle %v5float %vs_a %vs_b 0 1 2 5 6
               OpReturnValue %vsr
               OpFunctionEnd

      %fn_ac = OpFunction %float None %fnty_ac
       %ac_i = OpFunctionParameter %uint
   %entry_ac = OpLabel
     %ac_var = OpVariable %ptr_fn_v5f Function
     %ac_gep = OpAccessChain %ptr_fn_flt %ac_var %ac_i
     %ac_val = OpLoad %float %ac_gep
               OpReturnValue %ac_val
               OpFunctionEnd
