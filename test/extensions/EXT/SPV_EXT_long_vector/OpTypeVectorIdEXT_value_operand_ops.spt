; The OpTypeVectorIdEXT kernel parameter mangles to the "float4" OpenCL type name.
; CHECK: define spir_kernel void @test_mangling(<4 x float> %{{.*}}) {{.*}} !kernel_arg_type ![[#TYPE:]]
