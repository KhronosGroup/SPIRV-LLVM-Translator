; Reverse-translation of OpTypeVectorIdEXT used as operand/result types of these
; ops in general: binary (OpFAdd), select (OpSelect), unary (OpFNegate),
; dot (OpDot), comparison (OpFOrdEqual, OpIEqual), conversions (OpFConvert,
; OpSConvert, OpUConvert), and the vector/matrix multiply ops (OpVectorTimesScalar,
; OpVectorTimesMatrix, OpMatrixTimesVector). It also
; checks the OpenCL type-name mangling (!kernel_arg_type metadata) of an
; OpTypeVectorIdEXT kernel parameter.

; RUN: llvm-spirv -spirv-text -r %s -o - | llvm-dis | FileCheck %s

119734787 66304 458752 101 0
2 Capability Matrix
2 Capability Addresses
2 Capability Linkage
2 Capability Kernel
2 Capability Int64
2 Capability Int16
2 Capability GenericPointer
2 Capability Float8EXT
2 Capability LongVectorEXT
5 Extension "SPV_EXT_float8"
6 Extension "SPV_EXT_long_vector"
3 MemoryModel 2 2
7 EntryPoint 6 1 "test_mangling"
3 Source 3 102000
5 Name 2 "test_fadd"
5 Name 3 "test_select"
6 Name 4 "test_fnegate"
5 Name 5 "test_dot"
6 Name 6 "test_fordequal"
6 Name 7 "test_iequal_sc"
7 Name 8 "test_f32_to_e4m3"
7 Name 9 "test_e4m3_to_f32"
6 Name 10 "test_sconvert"
6 Name 11 "test_uconvert"
5 Name 12 "test_vts"
5 Name 13 "test_vtm"
5 Name 14 "test_mtv"

7 Decorate 2 LinkageAttributes "test_fadd" Export
7 Decorate 3 LinkageAttributes "test_select" Export
8 Decorate 4 LinkageAttributes "test_fnegate" Export
7 Decorate 5 LinkageAttributes "test_dot" Export
8 Decorate 6 LinkageAttributes "test_fordequal" Export
8 Decorate 7 LinkageAttributes "test_iequal_sc" Export
9 Decorate 8 LinkageAttributes "test_f32_to_e4m3" Export
9 Decorate 9 LinkageAttributes "test_e4m3_to_f32" Export
8 Decorate 10 LinkageAttributes "test_sconvert" Export
8 Decorate 11 LinkageAttributes "test_uconvert" Export
7 Decorate 12 LinkageAttributes "test_vts" Export
7 Decorate 13 LinkageAttributes "test_vtm" Export
7 Decorate 14 LinkageAttributes "test_mtv" Export
4 TypeInt 16 32 0
4 TypeInt 19 16 0
4 TypeInt 20 64 0
4 Constant 16 22 4
4 Constant 16 23 3
4 SpecConstant 16 24 4
2 TypeVoid 15
3 TypeFloat 17 32
2 TypeBool 18
4 TypeFloat 21 8 4214
4 TypeVectorIdEXT 25 17 22
4 TypeVectorIdEXT 26 17 23
4 TypeVectorIdEXT 27 18 22
4 TypeVectorIdEXT 28 16 24
4 TypeVectorIdEXT 29 18 24
4 TypeVectorIdEXT 30 21 22
4 TypeVectorIdEXT 31 19 22
4 TypeVectorIdEXT 32 16 22
4 TypeVectorIdEXT 33 20 22
4 TypeVector 34 17 4
4 TypeVector 35 17 3
4 TypeMatrix 36 34 3
5 TypeFunction 37 25 25 25
6 TypeFunction 38 25 27 25 25
4 TypeFunction 39 25 25
