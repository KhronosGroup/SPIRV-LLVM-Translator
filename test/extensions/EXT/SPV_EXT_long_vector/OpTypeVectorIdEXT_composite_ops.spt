; Checks reverse-translation of value-level ops on an OpTypeVectorIdEXT value:
; OpConstantComposite, OpSpecConstantComposite, OpCompositeConstruct,
; OpCompositeExtract, OpCompositeInsert.

; RUN: llvm-spirv -spirv-text -r %s -o - | llvm-dis | FileCheck %s

119734787 66304 458752 30 0
2 Capability Addresses
2 Capability Linkage
2 Capability Kernel
2 Capability LongVectorEXT
6 Extension "SPV_EXT_long_vector"
3 MemoryModel 2 2
3 Source 3 102000
8 Name 1 "test_const_composite"
7 Name 2 "test_spec_composite"
9 Name 3 "test_composite_construct"
8 Name 4 "test_composite_extract"
8 Name 5 "test_composite_insert"

10 Decorate 1 LinkageAttributes "test_const_composite" Export
9 Decorate 2 LinkageAttributes "test_spec_composite" Export
11 Decorate 3 LinkageAttributes "test_composite_construct" Export
10 Decorate 4 LinkageAttributes "test_composite_extract" Export
10 Decorate 5 LinkageAttributes "test_composite_insert" Export
4 TypeInt 6 32 0
4 Constant 6 8 5
3 TypeFloat 7 32
4 TypeVectorIdEXT 11 7 8
3 TypeFunction 14 11
4 TypeFunction 15 11 7
4 TypeFunction 16 7 11
5 TypeFunction 17 11 11 7
4 Constant 7 9 1065353216
4 SpecConstant 7 10 1073741824
8 ConstantComposite 11 12 9 9 9 9 9

8 SpecConstantComposite 11 13 10 10 10 10 10

; CHECK: define spir_func <5 x float> @test_const_composite()
; CHECK: ret <5 x float> splat (float 1.000000e+00)
5 Function 11 1 0 14

2 Label 18
2 ReturnValue 12

1 FunctionEnd

; CHECK: define spir_func <5 x float> @test_spec_composite()
; CHECK: ret <5 x float> splat (float 2.000000e+00)
5 Function 11 2 0 14

2 Label 19
2 ReturnValue 13

1 FunctionEnd

; CHECK: define spir_func <5 x float> @test_composite_construct(float %[[#A:]])
; CHECK: insertelement <5 x float> poison, float %[[#A]], i32 0
5 Function 11 3 0 15
3 FunctionParameter 7 20

2 Label 21
8 CompositeConstruct 11 22 20 20 20 20 20
2 ReturnValue 22

1 FunctionEnd

; CHECK: define spir_func float @test_composite_extract(<5 x float> %[[#V:]])
; CHECK: extractelement <5 x float> %[[#V]], i32 3
5 Function 7 4 0 16
3 FunctionParameter 11 23

2 Label 24
5 CompositeExtract 7 25 23 3
2 ReturnValue 25

1 FunctionEnd

; CHECK: define spir_func <5 x float> @test_composite_insert(<5 x float> %[[#V:]], float %[[#S:]])
; CHECK: insertelement <5 x float> %[[#V]], float %[[#S]], i32 2
5 Function 11 5 0 17
3 FunctionParameter 11 26
3 FunctionParameter 7 27

2 Label 28
6 CompositeInsert 11 29 27 26 2
2 ReturnValue 29

1 FunctionEnd
