; Unlike the FP4/FP8 mini-float encodings, plain Int4 has no RTE-only
; restriction: a non-default FPRoundingMode on a conversion to/from Int4
; must translate normally, not be rejected.

; RUN: llvm-spirv %s -to-binary -o %t.spv
; RUN: llvm-spirv %t.spv -r --spirv-target-env=SPV-IR -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc -o - | FileCheck %s --check-prefix=CHECK-LLVM

; CHECK-LLVM: call spir_func i4 @_Z38__builtin_spirv_ConvertFP16ToInt4INTELDh(half

119734787 65536 393230 11 0
2 Capability Addresses
2 Capability Linkage
2 Capability Kernel
2 Capability Float16Buffer
2 Capability Int4TypeINTEL
5 Extension "SPV_INTEL_int4"
5 ExtInstImport 1 "OpenCL.std"
3 MemoryModel 1 2
3 Source 0 0
3 Name 4 "f"
4 Name 5 "entry"
5 Decorate 4 LinkageAttributes "f" Export
4 Decorate 9 FPRoundingMode 1
3 TypeFloat 2 16
4 Constant 2 7 15360
4 TypeInt 8 4 0
3 TypeFunction 3 8
5 Function 8 4 0 3
2 Label 5
4 ConvertFToS 8 9 7
2 ReturnValue 9
1 FunctionEnd
