; REQUIRES: spirv-as
; RUN: spirv-as --target-env spv1.0 -o %t.spv %s
; RUN: spirv-val %t.spv
; RUN: llvm-spirv -r %t.spv -o %t.rev.bc
; RUN: llvm-dis %t.rev.bc
; RUN: FileCheck < %t.rev.ll %s

; An OpCompositeConstruct vector constituent contributes all of its components,
; in order, to the resulting vector.

; CHECK: define spir_kernel void @k(ptr addrspace(1) %{{.*}}, i32 %[[#N:]])
; CHECK: %[[#V3:]] = insertelement <3 x i32> poison, i32 %[[#N]], i32 0
; CHECK: %[[#V3_1:]] = insertelement <3 x i32> %[[#V3]], i32 %[[#N]], i32 1
; CHECK: %[[#V3_2:]] = insertelement <3 x i32> %[[#V3_1]], i32 %[[#N]], i32 2
; CHECK: %[[#E0:]] = extractelement <3 x i32> %[[#V3_2]], i32 0
; CHECK: %[[#V4_0:]] = insertelement <4 x i32> poison, i32 %[[#E0]], i32 0
; CHECK: %[[#E1:]] = extractelement <3 x i32> %[[#V3_2]], i32 1
; CHECK: %[[#V4_1:]] = insertelement <4 x i32> %[[#V4_0]], i32 %[[#E1]], i32 1
; CHECK: %[[#E2:]] = extractelement <3 x i32> %[[#V3_2]], i32 2
; CHECK: %[[#V4_2:]] = insertelement <4 x i32> %[[#V4_1]], i32 %[[#E2]], i32 2
; CHECK: %[[#V4_3:]] = insertelement <4 x i32> %[[#V4_2]], i32 0, i32 3
; CHECK: store <4 x i32> %[[#V4_3]]
; CHECK: store <4 x i32> <i32 1, i32 2, i32 3, i32 0>

               OpCapability Addresses
               OpCapability Kernel
               OpMemoryModel Physical64 OpenCL
               OpEntryPoint Kernel %k "k"
       %void = OpTypeVoid
       %uint = OpTypeInt 32 0
     %v3uint = OpTypeVector %uint 3
     %v4uint = OpTypeVector %uint 4
      %ptr_g = OpTypePointer CrossWorkgroup %v4uint
      %fnty  = OpTypeFunction %void %ptr_g %uint
     %uint_0 = OpConstant %uint 0
     %uint_1 = OpConstant %uint 1
     %uint_2 = OpConstant %uint 2
     %uint_3 = OpConstant %uint 3
   %c_v3uint = OpConstantComposite %v3uint %uint_1 %uint_2 %uint_3
          %k = OpFunction %void None %fnty
        %out = OpFunctionParameter %ptr_g
          %n = OpFunctionParameter %uint
      %entry = OpLabel
        %rt3 = OpCompositeConstruct %v3uint %n %n %n
         %v4 = OpCompositeConstruct %v4uint %rt3 %uint_0
               OpStore %out %v4 Aligned 16
         %c4 = OpCompositeConstruct %v4uint %c_v3uint %uint_0
               OpStore %out %c4 Aligned 16
               OpReturn
               OpFunctionEnd
