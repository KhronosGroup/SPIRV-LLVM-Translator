;; Translator versions up to 14 emit the DebugLocalVariable ArgNumber operand as
;; a Literal. Check that such Literals are read as argument numbers even when a
;; Literal coincides with the <id> of an integer OpConstant: here ArgNumber 2 is
;; also the <id> of OpConstant 1. The module is not valid SPIR-V for that reason.

; RUN: llvm-spirv %s -to-binary -o %t.spv
; RUN: llvm-spirv -r %t.spv -o - | llvm-dis | FileCheck %s --check-prefix=CHECK-LLVM

; CHECK-LLVM-DAG: DILocalVariable(name: "a", arg: 1,
; CHECK-LLVM-DAG: DILocalVariable(name: "b", arg: 2,

