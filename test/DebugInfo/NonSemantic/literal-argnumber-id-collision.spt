;; Check that Literal DebugLocalVariable ArgNumber operands emitted by older
;; translators are read correctly for NonSemantic instruction sets even when a
;; Literal coincides with the <id> of an unrelated integer OpConstant. Here
;; Literal ArgNumber 2 is also the <id> of OpConstant 1; it must not be read as
;; arg 1, which would clash with parameter "a" and break the module.

; RUN: llvm-spirv %s -to-binary -o %t.spv
; RUN: llvm-spirv -r %t.spv -o %t.bc
; RUN: llvm-dis < %t.bc | FileCheck %s --check-prefix=CHECK-LLVM

; CHECK-LLVM-DAG: DILocalVariable(name: "a", arg: 1,
; CHECK-LLVM-DAG: DILocalVariable(name: "c", arg: 2,

